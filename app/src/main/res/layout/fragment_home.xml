<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- بطاقة الترحيب بـ سيرفرك الخاص (بدون زر تثبيت) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16pg"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="مرحباً بك في سيرفرك المفضل"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="جاهز للعب الان بجودة عالية وأداء مستقر"
                android:textColor="#AAAAAA"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- لوحة التحكم السريع بالاسم والإعدادات -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/editNickname"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@drawable/input_bg"
                android:hint="اسم اللاعب (Nickname)"
                android:paddingHorizontal="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#777777"
                android:textSize="14sp"/>
        </LinearLayout>

        <!-- قسم السيرفر الوحيد المخصص -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="السيرفر الرئيسي"
            android:textColor="#BB86FC"
            android:textStyle="bold"
            android:textSize="16sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_bg"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Las Venturas RP"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="15sp"/>

                <TextView
                    android:id="@+id/serverStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="متصل • البينغ: 35ms"
                    android:textColor="#03DAC5"
                    android:textSize="12sp"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnPlayServer"
                android:layout_width="90dp"
                android:layout_height="40dp"
                android:backgroundTint="#BB86FC"
                android:text="دخول"
                android:textColor="#000000"
                android:textStyle="bold"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
